# Copy this file to .env. Never commit .env or paste these values into GitHub.

# Hindsight Cloud: copy the API URL and token from the Hindsight Cloud
# dashboard's Connect/API instructions.
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_TOKEN=hsk_replace_with_your_token

# Optional Groq synthesis.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional research connectors and service controls.
TAVILY_API_KEY=
HINDSIGHT_BANK_PREFIX=quantmind-
FORESIGHT_CACHE_TTL_SECONDS=300
FORESIGHT_LOG_LEVEL=INFO
# Demo-only synthetic evidence fallback; set false for live-only research.
FORESIGHT_DEMO_MODE=true

# SEC requests require an honest contact identifier.
FORESIGHT_SEC_USER_AGENT=Your Name contact@example.com
